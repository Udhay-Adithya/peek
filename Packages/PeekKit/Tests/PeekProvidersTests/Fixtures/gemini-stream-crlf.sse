data: {"candidates": [{"content": {"parts": [{"text": "Breadth-First Search (BFS"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 14,"candidatesTokenCount": 7,"totalTokenCount": 644,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 14}],"thoughtsTokenCount": 623,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "8jSxaoSHGeOLjuMPrcjvsQE"}

data: {"candidates": [{"content": {"parts": [{"text": ") is a graph traversal algorithm that explores a graph or tree level by level. Starting from a specified root node, BFS first visits all of its immediate neighbors. Then, for each of those neighbors, it explores their unvisited neighbors, and"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 14,"candidatesTokenCount": 55,"totalTokenCount": 692,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 14}],"thoughtsTokenCount": 623,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "8jSxaoSHGeOLjuMPrcjvsQE"}

data: {"candidates": [{"content": {"parts": [{"text": " so on, moving progressively further away from the starting point.\n\nThe algorithm achieves this layer-by-layer exploration by using a queue data structure. The starting node is added to the queue and marked as visited. The algorithm then repeatedly dequeues"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 14,"candidatesTokenCount": 104,"totalTokenCount": 741,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 14}],"thoughtsTokenCount": 623,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "8jSxaoSHGeOLjuMPrcjvsQE"}

data: {"candidates": [{"content": {"parts": [{"text": " a node, processes it, and enqueues all of its unvisited neighbors, marking them visited. This \"first-in, first-out\" behavior of the queue ensures that all nodes at the current depth are fully explored before any nodes"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 14,"candidatesTokenCount": 153,"totalTokenCount": 790,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 14}],"thoughtsTokenCount": 623,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "8jSxaoSHGeOLjuMPrcjvsQE"}

data: {"candidates": [{"content": {"parts": [{"text": " at the next depth are considered.\n\nBFS is particularly useful for finding the shortest path between two nodes in an unweighted graph, as it inherently discovers nodes in increasing order of their distance from the start node."}],"role": "model"},"finishReason": "STOP","index": 0}],"usageMetadata": {"promptTokenCount": 14,"candidatesTokenCount": 195,"totalTokenCount": 832,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 14}],"thoughtsTokenCount": 623,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "8jSxaoSHGeOLjuMPrcjvsQE"}

