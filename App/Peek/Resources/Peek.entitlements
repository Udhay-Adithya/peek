<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is off. Reading the user's selection from another process
	     via the Accessibility API is blocked by the sandbox and no entitlement
	     lifts that restriction, so Peek ships Developer ID + notarized. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Required for dictation. The Hardened Runtime denies microphone access
	     without this entitlement even in an unsandboxed app: the usage string
	     alone gets you a prompt the user can accept and a capture session that
	     then fails. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
