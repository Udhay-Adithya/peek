<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu-bar resident: no Dock icon, no main window on launch. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Puts "Ask Peek" in every app's Services menu. Needs no permissions:
	     macOS hands the selection over on the pasteboard. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask Peek</string>
			</dict>
			<key>NSMessage</key>
			<string>askPeek</string>
			<key>NSPortName</key>
			<string>Peek</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Fix Spelling &amp; Grammar with Peek</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteFixGrammar</string>
			<key>NSPortName</key>
			<string>Peek</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Improve Writing with Peek</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteImprove</string>
			<key>NSPortName</key>
			<string>Peek</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Make Shorter with Peek</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteShorten</string>
			<key>NSPortName</key>
			<string>Peek</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle. SUPublicEDKey is the PUBLIC half of the update signing key
	     and belongs in version control: it is what lets an installed copy of
	     Peek reject any build not signed with the matching private key, even
	     if GitHub Releases were compromised. The private half lives only in
	     the release machine's login keychain.

	     This value must never change between releases — existing installs
	     verify against the key they shipped with and would reject updates
	     signed by a different one. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Udhay-Adithya/peek/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>obgL2g2+cxZpEqjr4lArI43ixIKGvpkcHSC/1Y33ols=</string>
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Udhay Adithya J. All rights reserved.</string>
</dict>
</plist>
